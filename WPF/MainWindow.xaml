<Window x:Class="HerbLight_Advisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HerbLight_Advisor"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="500" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" HorizontalAlignment="Right" Margin="20,20,10,20" Source="/Resources/Default.png" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Column="1" Text="Herb Light Advisor" FontWeight="Bold" FontFamily="Comic Sans MS" VerticalAlignment="Center" FontSize="25">
                <TextBlock.Foreground>
                    <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Color="LawnGreen" Offset="0"/>
                        <GradientStop Color="Green" Offset="0.5"/>
                        <GradientStop Color="Black" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Herb" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
            <ComboBox x:Name="PlantList" Grid.Row="0" Grid.Column="1" Margin="0,10,10,10"/>
            <Button x:Name="AppplyBtn" Content="Apply" Grid.Row="0" Grid.Column="2" Margin="10,10,0,10" FontSize="15" FontWeight="SemiBold"/>
            <Label Content="PPFD" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
            <Slider x:Name="PpfdSlider" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,10,5,10" Maximum="2000" Minimum="0"/>
            <TextBox x:Name="PpfdText" Grid.Row="1" Grid.Column="2" VerticalContentAlignment="Center" Margin="10,10,0,10"/>
            <Label Content="Time" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
            <Slider x:Name="LightTimeSlider" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,10,5,10" Maximum="18" Minimum="0"/>
            <TextBox x:Name="LightTimeText" Grid.Row="2" Grid.Column="2" VerticalContentAlignment="Center" Margin="10,10,0,10"/>
        </Grid>

        <Grid Grid.Row="2" Margin="20, 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Label Content="DLI" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
            <Slider x:Name="DLISlider" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0" Maximum="200" Minimum="0"/>
            <TextBox x:Name="DLIText" Grid.Row="0" Grid.Column="2" VerticalContentAlignment="Center" Margin="10,10,0,10"/>

            <TextBox x:Name="Notice" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" VerticalContentAlignment="Center" Margin="10"/>
        </Grid>

    </Grid>
</Window>
