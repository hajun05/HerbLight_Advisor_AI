<Window x:Class="HerbLight_Advisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HerbLight_Advisor"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        FontSize="18"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="550" Width="450" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" HorizontalAlignment="Right" Margin="20,20,10,20" Source="/Resources/Default.png" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Column="1" Text="Herb Light Advisor" FontWeight="Bold" FontFamily="Comic Sans MS" VerticalAlignment="Center" FontSize="28">
                <TextBlock.Foreground>
                    <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Color="LawnGreen" Offset="0"/>
                        <GradientStop Color="Green" Offset="0.5"/>
                        <GradientStop Color="Black" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Herb" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="HerbList" Grid.Row="0" Grid.Column="1" Margin="0,10,10,10" VerticalContentAlignment="Center" Padding="10,0"/>
            <Button x:Name="ApplyBtn" Content="확인" Grid.Row="0" Grid.Column="2" Margin="10,10,0,10" FontWeight="SemiBold" Click="ApplyBtn_Click"/>

            <Label Content="PPFD" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Slider x:Name="PpfdSlider" Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,5,0"
                        Maximum="2000" Minimum="0" TickPlacement="BottomRight" TickFrequency="200" ValueChanged="PpfdSlider_ValueChanged" />
                <TextBlock Text="0" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="10" Foreground="Gray" Margin="2,48,0,0" Grid.RowSpan="2"/>
                <TextBlock Text="2000" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="10" Foreground="Gray" Margin="0,48,0,0" Grid.RowSpan="2"/>
            </Grid>
            <TextBox x:Name="PpfdText" Grid.Row="1" Grid.Column="2" VerticalContentAlignment="Center" Margin="10,10,0,10" Padding="3,0" PreviewTextInput="Text_PreviewTextInput" GotFocus="Text_GotFocus" LostFocus="PpfdText_LostFocus" KeyDown="TextBox_EnterKeyDown"/>

            <Label Content="Time" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Slider x:Name="LightTimeSlider" Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,5,0"
                        Maximum="18" Minimum="0" TickPlacement="BottomRight" TickFrequency="2" ValueChanged="LightTimeSlider_ValueChanged"/>
                <TextBlock Text="0" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="10" Foreground="Gray" Margin="2,48,0,0" Grid.RowSpan="2"/>
                <TextBlock Text="18" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="10" Foreground="Gray" Margin="0,48,5,0" Grid.RowSpan="2"/>
            </Grid>
            <TextBox x:Name="LightTimeText" Grid.Row="2" Grid.Column="2" VerticalContentAlignment="Center" Margin="10,10,0,10" PreviewTextInput="Text_PreviewTextInput" GotFocus="Text_GotFocus" LostFocus="LightTimeText_LostFocus" KeyDown="TextBox_EnterKeyDown"/>
        </Grid>

        <Grid Grid.Row="2" Margin="20, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Label Content="DLI" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Slider x:Name="DLISlider" Grid.Row="0" VerticalAlignment="Bottom"  Margin="0,0,5,0"
                        Maximum="200" Minimum="0" TickPlacement="BottomRight" TickFrequency="20" IsHitTestVisible="False"/>
                <TextBlock Text="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="10" Foreground="Gray" Margin="2,0,0,0"/>
                <TextBlock Text="100" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="10" Foreground="Gray" Margin="117,0,0,0"/>
                <TextBlock Text="200" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="10" Foreground="Gray" Margin="237,0,0,0"/>
            </Grid>
            <TextBox x:Name="DLIText" Grid.Row="0" Grid.Column="2" VerticalContentAlignment="Center" Margin="10,10,0,10"/>

            <TextBox x:Name="Notice1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalContentAlignment="Center" HorizontalAlignment="Center" BorderThickness="0" FontSize="18" IsReadOnly="True"/>
            <Button x:Name="InitBtn" Content="초기화" Grid.Row="1" Grid.Column="2" Margin="10,10,0,10" Visibility="Hidden" Click="InitBtn_Click"/>
            <TextBox x:Name="Notice2" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalContentAlignment="Top" HorizontalAlignment="Left" TextWrapping="Wrap" BorderThickness="0" IsReadOnly="True"/>
        </Grid>

    </Grid>
</Window>
